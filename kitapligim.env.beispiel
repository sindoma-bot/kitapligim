# Kopie als "kitapligim.env" im selben Ordner speichern und ausfüllen. Diese Datei NIE ins GitHub hochladen.

# SHA-256-Prüfsumme des Passworts (Kleinbuchstaben). Am einfachsten derselbe Wert wie PW_HASH_KENAN
# in docker/automaten-kassierung/kassierung.env, dann gilt dasselbe Passwort wie bei der Kassierung.
PW_HASH=

# Wie viele Tage ein Gerät angemeldet bleibt
SITZUNG_TAGE=365
